NEXT_PUBLIC_NOVA_APP_NAME=NOVA
NEXT_PUBLIC_NOVA_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NOVA_SCAN_WORKER_URL=
NOVA_SCAN_WORKER_SECRET=

# Phase 4 — free automatic competitor discovery
# Optional: point NOVA at your own SearXNG instance. If blank, NOVA uses healthy public SearXNG instances with failover.
SEARXNG_URL=
# Set true only if you explicitly want to disable automatic discovery
DISABLE_FREE_DISCOVERY=false

CRON_SECRET=
NEXT_PUBLIC_NOVA_APP_URL=http://localhost:3000
# Required for /admin global console (server-only; never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Optional explicit auth origin fallback; Vercel request headers are used first
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=https://your-nova-domain.vercel.app

# NOVA AI Layer V1 — both are optional. Gemini is primary; Groq is automatic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional third AI fallback (free models router)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# NOVA AI Operating System (server-side only)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# NOVA AI Operating System (server-side only)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Recommended free live web search for competitor discovery
# Free tier currently includes 1,000 API credits/month with no credit card required
TAVILY_API_KEY=
